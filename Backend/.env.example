# BlackBox Regulatory Guardian - Environment Configuration
# Copy this file to .env and fill in your values.

# --- LLM Configuration ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3
LLM_TEMPERATURE=0.0
LLM_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# --- LRR Monitoring ---
LRR_POLL_INTERVAL_HOURS=6
LRR_ENABLED=True

# --- Guardrails ---
GUARDRAILS_STRICT_MODE=True
GUARDRAILS_LOG_VIOLATIONS=True
GUARDRAILS_BLOCK_ON_FAILURE=False

# --- Database ---
DATABASE_URL=sqlite:///./sql_app.db

# --- Pinecone Vector DB Configuration ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=regulatory-guardian-policies
PINECONE_ENVIRONMENT=us-east-1

# --- Embeddings Configuration ---
# Options: "google", "openai", "local" (sentence-transformers)
EMBEDDING_PROVIDER=local
# If using EMBEDDING_PROVIDER=local, set model name (e.g. all-MiniLM-L6-v2 for 384d, BAAI/bge-large-en-v1.5 for 1024d)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
